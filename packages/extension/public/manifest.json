{
  "manifest_version": 3,
  "name": "Website Review",
  "short_name": "Review",
  "version": "0.1.0",
  "key": "",
  "description": "Kommentare mit Screenshot auf Dev- und Staging-Seiten erfassen und über den lokalen Begleitdienst als Kan-Tickets verarbeiten.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Website Review öffnen",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "tabs",
    "activeTab",
    "nativeMessaging"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ]
}
